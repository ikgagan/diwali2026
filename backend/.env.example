# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Google Drive (from scripts/get_refresh_token.py) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The party folder that holds the originals. medium/ and thumbs/ live inside it.
DRIVE_FOLDER_ID=1wV-77g0hQcs3SFf-OZYM1sZd---WQ3LS
DRIVE_FOLDER_LINK=https://drive.google.com/drive/folders/1wV-77g0hQcs3SFf-OZYM1sZd---WQ3LS

# --- Web ---
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://ikgagan.github.io
GALLERY_ROTATE_MINUTES=20
GALLERY_PAGE_SIZE=10
MAX_UPLOAD_MB=25
UPLOAD_RATE_LIMIT=30/minute
INDEX_REFRESH_SECONDS=60

# --- Protection ---
# Guests must type this on the Upload page before uploading. Leave empty to disable.
EVENT_PASSCODE=CHANGE_ME_EVENT_PASSCODE
# Long random secret for the hidden /admin page (delete photos). Leave empty to disable.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
